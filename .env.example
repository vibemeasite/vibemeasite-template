# All of these are set by vibemeasite-mcp on the Vercel project at
# provisioning time (US-VMAS-DEPLOY-03 / US-VMAS-DEPLOY-04) — nothing here
# needs to be filled in manually except for local development against a
# throwaway site.

# This site's own dedicated Postgres database (Neon/Vercel Postgres).
POSTGRES_URL=

# Secret used to authenticate POST /api/revalidate calls from vibemeasite-mcp.
REVALIDATE_SECRET=

# This site's Cellpy service-account org slug (see
# apps/web/app/api/internal/service-accounts/route.ts) — used to build
# container CDN URLs.
CELLPY_ACCOUNT_SLUG=

# Optional override, defaults to https://cdn.cellpy.com
CELLPY_CDN_BASE_URL=
